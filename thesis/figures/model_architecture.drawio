        <mxCell id="hpe_blk" value="&lt;b&gt;Block Group&lt;/b&gt;&lt;br/&gt;&lt;font color='#1E3A8A' size='1'&gt;&amp;bull; Line gap &amp;lt; 1.8x H&lt;br/&gt;&amp;bull; Semantic section&lt;/font&gt;&lt;br/&gt;&lt;b&gt;E&lt;sub&gt;block&lt;/sub&gt;&lt;/b&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.5;rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="290" y="480" width="100" height="110" as="geometry" />
