        <mxCell id="edge_emb_bb" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2.2;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1D4ED8;" edge="1" parent="1" source="emb_1d" target="backbone">
