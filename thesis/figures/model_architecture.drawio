        <!-- Backbone to Token and Patch states -->
        <mxCell id="edge_bb_tokens" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2.2;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1D4ED8;" edge="1" parent="1" source="backbone" target="vec_tokens">
