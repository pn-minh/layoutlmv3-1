        <mxCell id="28" value="&lt;b&gt;Adjacent Word Pair&lt;/b&gt;&lt;br/&gt;&lt;font size="1" color="#78350F"&gt;Same text line: [ h&lt;sub&gt;i&lt;/sub&gt; ; h&lt;sub&gt;i+1&lt;/sub&gt; ]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="1075" y="520" width="165" height="65" as="geometry" />
