        <mxCell id="edge_hpe_bb" value="Hierarchical Bias (&amp;beta;)" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2.2;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B45309;fontColor=#78350F;fontSize=10;" edge="1" parent="1" source="hpe_scale" target="backbone">
          <mxGeometry relative="1" as="geometry" />
