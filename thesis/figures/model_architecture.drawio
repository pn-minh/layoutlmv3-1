        <mxCell id="edge_proj_scale" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.8;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B45309;" edge="1" parent="1" source="hpe_proj" target="hpe_scale">
