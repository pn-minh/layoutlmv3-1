        </mxCell>
        <mxCell id="20" value="&lt;b&gt;Segment Mean Pool&lt;/b&gt;&lt;br/&gt;&lt;font size="1" color="#065F46"&gt;Averages tokens in line k&lt;br/&gt;&amp;rarr; Segment vector s&lt;sub&gt;k&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
