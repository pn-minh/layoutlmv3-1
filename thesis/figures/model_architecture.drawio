        <!-- Concat + Linear Projection -->
        <mxCell id="hpe_proj" value="&lt;b&gt;Hierarchical Linear Projection (W&lt;sub&gt;hier&lt;/sub&gt;)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#475569'&gt;Concat [ E&lt;sub&gt;line&lt;/sub&gt; ; E&lt;sub&gt;col&lt;/sub&gt; ; E&lt;sub&gt;block&lt;/sub&gt; ] &amp;rarr; &amp;Ropf;&lt;sup&gt;d&lt;/sup&gt;&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.8;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="60" y="625" width="330" height="55" as="geometry" />
        </mxCell>

        <!-- Scaled Residual Injection -->
        <mxCell id="hpe_scale" value="&lt;b&gt;Residual Hierarchical Representation (E&lt;sub&gt;hier&lt;/sub&gt; &amp;times; &amp;beta;)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#475569'&gt;Injected into initial token embedding stream&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.8;rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="330" height="60" as="geometry" />
        </mxCell>


        <!-- ================================================================= -->
