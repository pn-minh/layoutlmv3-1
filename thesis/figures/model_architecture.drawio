        <!-- Losses to Total Objective Banner -->
        <mxCell id="loss_ce_to_banner" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;" edge="1" parent="1" source="cls_loss" target="total_loss_banner">
