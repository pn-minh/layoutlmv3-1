        <mxCell id="21" value="&lt;b&gt;Segment Transformer&lt;/b&gt;&lt;br/&gt;&lt;font size="1" color="#065F46"&gt;1-Layer, 4-Head Attention&lt;br/&gt;Inter-segment context c&lt;sub&gt;k&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="90" width="195" height="65" as="geometry" />
