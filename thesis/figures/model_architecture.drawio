        <mxCell id="cls_container" value="&lt;b&gt;4. Direct Token Classifier Head&lt;/b&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#F8FAFC;strokeColor=#334155;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
