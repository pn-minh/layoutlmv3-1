        <mxCell id="19" value="&lt;b&gt;3. Segment Context Module (SCM)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontColor=#064E3B;fontSize=13;" vertex="1" parent="1">
