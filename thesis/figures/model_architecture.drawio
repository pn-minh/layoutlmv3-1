        <mxCell id="22" value="&lt;b&gt;ReZero Residual Gate&lt;/b&gt;&lt;br/&gt;&lt;font size="1" color="#065F46"&gt;s&lt;sub&gt;k&lt;/sub&gt; + g &amp;times; (c&lt;sub&gt;k&lt;/sub&gt; - s&lt;sub&gt;k&lt;/sub&gt;)&lt;br/&gt;Refined segment s&amp;#39;&lt;sub&gt;k&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1535" y="90" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;Broadcast Segment Context + Segment-Start Onset Embedding: h&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;final&lt;/sup&gt; = h&lt;sub&gt;i&lt;/sub&gt; + s&amp;#39;&lt;sub&gt;s(i)&lt;/sub&gt; + e&lt;sup&gt;onset&lt;/sup&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1075" y="180" width="660" height="55" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;4. Direct Token Classifier Head&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1050" y="305" width="710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;Linear Classification Layer&lt;/b&gt;&lt;br/&gt;&lt;font size="1" color="#475569"&gt;Projects h&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;final&lt;/sup&gt; directly to class logits z&lt;sub&gt;i&lt;/sub&gt;&lt;br/&gt;(Zero added inference latency)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.8;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1075" y="355" width="305" height="65" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;Entity Cross-Entropy Loss (&lt;font color="#DC2626"&gt;L&lt;sub&gt;CE&lt;/sub&gt;&lt;/font&gt;)&lt;/b&gt;&lt;br/&gt;&lt;font size="1" color="#475569"&gt;Softmax probabilities vs ground-truth IOB2 tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.8;fontSize=11;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="1420" y="355" width="315" height="65" as="geometry" />
        </mxCell>
        <mxCell id="27" value="&lt;b&gt;5. Intra-Line Boundary Loss Classifier (Detailed Supervision)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1050" y="470" width="710" height="240" as="geometry" />
