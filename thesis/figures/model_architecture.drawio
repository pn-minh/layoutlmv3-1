        <!-- ================================================================= -->
        <mxCell id="scm_container" value="&lt;b&gt;3. Segment Context Module (SCM)&lt;/b&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#064E3B;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="950" y="30" width="710" height="230" as="geometry" />
        </mxCell>

        <mxCell id="scm_pool" value="&lt;b&gt;Segment Mean Pool&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#065F46'&gt;Average tokens in line k&lt;br/&gt;&amp;rarr; Segment vector s&lt;sub&gt;k&lt;/sub&gt;&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.5;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="980" y="80" width="180" height="65" as="geometry" />
        </mxCell>

        <mxCell id="scm_trans" value="&lt;b&gt;Segment Transformer&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#065F46'&gt;1-Layer, 4-Head Attention&lt;br/&gt;Inter-segment context c&lt;sub&gt;k&lt;/sub&gt;&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.5;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1200" y="80" width="190" height="65" as="geometry" />
        </mxCell>

        <mxCell id="scm_rezero" value="&lt;b&gt;ReZero Residual Gate&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#065F46'&gt;s&lt;sub&gt;k&lt;/sub&gt; + g &amp;times; (c&lt;sub&gt;k&lt;/sub&gt; - s&lt;sub&gt;k&lt;/sub&gt;)&lt;br/&gt;Refined segment s'&lt;sub&gt;k&lt;/sub&gt;&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.5;rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1430" y="80" width="190" height="65" as="geometry" />
        </mxCell>

        <mxCell id="scm_broadcast" value="&lt;b&gt;Broadcast Segment Context + Segment-Start Onset Embedding: h&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;final&lt;/sup&gt; = h&lt;sub&gt;i&lt;/sub&gt; + s'&lt;sub&gt;s(i)&lt;/sub&gt; + e&lt;sup&gt;onset&lt;/sup&gt;&lt;/b&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.5;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="980" y="170" width="640" height="50" as="geometry" />
        </mxCell>


