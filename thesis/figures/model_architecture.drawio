        <mxCell id="31" value="&lt;b&gt;Intra-Line Boundary BCE Loss (&lt;font color="#DC2626"&gt;L&lt;sub&gt;bound&lt;/sub&gt;&lt;/font&gt;)&lt;/b&gt;&lt;br/&gt;&lt;font size="1" color="#78350F"&gt;Directly penalizes false entity merges along the same reading line (prevents label bleed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.8;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="1075" y="615" width="660" height="50" as="geometry" />
