          <mxGeometry x="1170" y="495" width="150" height="65" as="geometry" />
        </mxCell>

        <!-- Visualized Ground Truth Shapes: Same Entity (0) vs Boundary (1) -->
        <mxCell id="bnd_visual_same" value="&lt;b&gt;Within Entity:&lt;/b&gt;&amp;nbsp;&amp;nbsp;[Word A]&amp;nbsp;&lt;font color='#2563EB'&gt;&amp;mdash;&amp;mdash;&amp;mdash;&lt;/font&gt;&amp;nbsp;[Word B]&amp;nbsp;&amp;nbsp;&amp;rarr;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color='#2563EB'&gt;Target = 0&lt;/font&gt;&lt;/b&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.5;rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="1350" y="490" width="270" height="34" as="geometry" />
        </mxCell>

        <mxCell id="bnd_visual_split" value="&lt;b&gt;Across Field:&lt;/b&gt;&amp;nbsp;&amp;nbsp;[Field Name]&amp;nbsp;&lt;b&gt;&lt;font color='#DC2626'&gt;|&lt;/font&gt;&lt;/b&gt;&amp;nbsp;[Field Value]&amp;nbsp;&amp;nbsp;&amp;rarr;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color='#DC2626'&gt;Target = 1&lt;/font&gt;&lt;/b&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.5;rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=10;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="1350" y="530" width="270" height="34" as="geometry" />
        </mxCell>

        <!-- Binary Loss Output -->
        <mxCell id="bnd_loss" value="&lt;b&gt;Intra-Line Boundary BCE Loss (&lt;font color='#DC2626'&gt;L&lt;sub&gt;bound&lt;/sub&gt;&lt;/font&gt;)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#78350F'&gt;Penalizes false entity merges along the same reading line&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.8;rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="980" y="585" width="640" height="48" as="geometry" />
        </mxCell>


        <!-- ================================================================= -->
        <!-- 7. CROSS-MODAL CONTRASTIVE LOSS MODULE                            -->
        <!-- ================================================================= -->
        <mxCell id="cont_container" value="&lt;b&gt;6. Cross-Modal Contrastive Loss (Text-Image Alignment)&lt;/b&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="950" y="680" width="710" height="210" as="geometry" />
        </mxCell>

        <!-- Projections -->
        <mxCell id="cont_txt" value="&lt;b&gt;Text Token Vector&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#1E40AF'&gt;Proj: z&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;text&lt;/sup&gt; = g&lt;sub&gt;text&lt;/sub&gt;(h&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;final&lt;/sup&gt;)&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.5;rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="980" y="730" width="170" height="65" as="geometry" />
        </mxCell>

        <mxCell id="cont_img" value="&lt;b&gt;Visual Patch Vector&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#065F46'&gt;Proj: z&lt;sub&gt;p(i)&lt;/sub&gt;&lt;sup&gt;img&lt;/sup&gt; = g&lt;sub&gt;img&lt;/sub&gt;(v&lt;sub&gt;p&lt;/sub&gt;)&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.5;rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="980" y="805" width="170" height="65" as="geometry" />
        </mxCell>

        <!-- Alignment Visual: Pull matched, Push negatives -->
        <mxCell id="cont_visual" value="&lt;b&gt;InfoNCE Temperature (&amp;tau; = 0.07)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color='#059669'&gt;&amp;harr; &lt;b&gt;PULL:&lt;/b&gt; Matched (Text Token, Image Patch)&lt;/font&gt;&lt;br/&gt;&lt;font color='#DC2626'&gt;&amp;harr; &lt;b&gt;PUSH:&lt;/b&gt; Distractor Non-matching Patches&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.8;rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1190" y="730" width="230" height="140" as="geometry" />
        </mxCell>

        <!-- Contrastive Loss Output -->
        <mxCell id="cont_loss" value="&lt;b&gt;Cross-Modal Contrastive Loss (&lt;font color='#DC2626'&gt;L&lt;sub&gt;cont&lt;/sub&gt;&lt;/font&gt;)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#065F46'&gt;Prevents visual representations from drifting during task fine-tuning&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.8;rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="1450" y="760" width="170" height="85" as="geometry" />
        </mxCell>


        <!-- ================================================================= -->
        <!-- 8. COMBINED MULTI-TASK LOSS (BOTTOM FULL-WIDTH)                   -->
        <!-- ================================================================= -->
        <mxCell id="total_loss_banner" value="&lt;b&gt;Joint Multi-Task Training Objective:&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;L&lt;sub&gt;total&lt;/sub&gt;&lt;/b&gt;&amp;nbsp;=&amp;nbsp;&lt;b&gt;L&lt;sub&gt;CE&lt;/sub&gt;&lt;/b&gt;&amp;nbsp;+&amp;nbsp;&lt;b&gt;&amp;lambda;&lt;sub&gt;bound&lt;/sub&gt;&amp;nbsp;&amp;times;&amp;nbsp;L&lt;sub&gt;bound&lt;/sub&gt;&lt;/b&gt;&amp;nbsp;+&amp;nbsp;&lt;b&gt;&amp;lambda;&lt;sub&gt;cont&lt;/sub&gt;&amp;nbsp;&amp;times;&amp;nbsp;L&lt;sub&gt;cont&lt;/sub&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font size='1' color='#94A3B8'&gt;(&amp;lambda;&lt;sub&gt;bound&lt;/sub&gt; = 0.2, &amp;lambda;&lt;sub&gt;cont&lt;/sub&gt; = 0.1)&lt;/font&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2;rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#020617;fontColor=#F8FAFC;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="915" width="1200" height="55" as="geometry" />
        </mxCell>


