        <mxCell id="edge_txt_vis" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.8;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;" edge="1" parent="1" source="cont_txt" target="cont_visual">
