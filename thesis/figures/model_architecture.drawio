        <mxCell id="edge_scm_2" value="+g" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=1.8;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;fontColor=#064E3B;fontStyle=1;" edge="1" parent="1" source="scm_trans" target="scm_rezero">
