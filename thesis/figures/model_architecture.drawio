        <mxCell id="35" value="&lt;b&gt;InfoNCE Alignment (&amp;tau; = 0.07):&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color="#059669"&gt;&amp;harr; &lt;b&gt;PULL:&lt;/b&gt; Matched (Token &amp;amp; Bounding-Box Patch)&lt;/font&gt;&lt;br/&gt;&lt;font color="#DC2626"&gt;&amp;harr; &lt;b&gt;PUSH:&lt;/b&gt; Non-matching Distractor Patches&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.8;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
