<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0">
  <diagram id="human_model_arch" name="Proposed Structure-Aware LayoutLMv3 Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================================================================= -->
        <!-- 1. DOCUMENT INPUTS CONTAINER (TOP-LEFT)                           -->
        <!-- ================================================================= -->
        <mxCell id="inp_container" value="&lt;b&gt;1. Multimodal Document Input&lt;/b&gt;" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#F8FAFC;strokeColor=#475569;fontColor=#1E293B;fontSize=13;" vertex="1" parent="1">
