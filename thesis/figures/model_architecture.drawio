        <mxCell id="32" value="&lt;b&gt;6. Cross-Modal Contrastive Loss (Text-Image Alignment)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=13;" vertex="1" parent="1">
