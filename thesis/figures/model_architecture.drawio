        <!-- SCM Broadcast to Classifier & Boundary Loss -->
        <mxCell id="edge_broadcast_cls" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#334155;" edge="1" parent="1" source="scm_broadcast" target="cls_head">
