        <!-- Tokens to SCM -->
        <mxCell id="edge_tokens_scm" value="Mean Pooling" style="sketch=1;curveFitting=1;jiggle=1.5;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;fontColor=#064E3B;fontSize=10;" edge="1" parent="1" source="vec_tokens" target="scm_pool">
