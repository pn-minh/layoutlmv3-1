        <mxCell id="29" value="&lt;b&gt;Boundary MLP&lt;/b&gt;&lt;br/&gt;&lt;font size="1" color="#78350F"&gt;Linear(2d&amp;rarr;d) &amp;rarr; ReLU&lt;br/&gt;&amp;rarr; Linear(d&amp;rarr;1) &amp;rarr; &amp;sigma;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="1270" y="520" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="30" value="&lt;b&gt;Ground-Truth Transition Signals:&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Within Entity:&lt;/b&gt;&amp;nbsp;&amp;nbsp;[Word A] &lt;font color="#2563EB"&gt;&amp;mdash;&amp;mdash;&amp;mdash;&lt;/font&gt; [Word B] &amp;rarr; &lt;b&gt;&lt;font color="#2563EB"&gt;Target = 0&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Entity Boundary:&lt;/b&gt;&amp;nbsp;&amp;nbsp;[Field Name] &lt;b&gt;&lt;font color="#DC2626"&gt;|&lt;/font&gt;&lt;/b&gt; [Field Value] &amp;rarr; &lt;b&gt;&lt;font color="#DC2626"&gt;Target = 1&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;" vertex="1" parent="1">
